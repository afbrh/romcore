diff --git a/cmake/dependencies/patches/romcore-sdl2-java-package.cmake b/cmake/dependencies/patches/romcore-sdl2-java-package.cmake
new file mode 100644
index 0000000..6cc100a
--- /dev/null
+++ b/cmake/dependencies/patches/romcore-sdl2-java-package.cmake
@@ -0,0 +1,11 @@
+# RomCore: relocate SDL2's Android Java package org.libsdl.app -> org.libsdl.appsoh so it cannot clash with the (different) SDL2
+# Java classes other RomCore cores already ship. Run as: cmake -DSDL_SRC=<sdl2 source dir> -P romcore-sdl2-java-package.cmake
+# (idempotent: already-renamed sources are left alone).
+foreach(f src/core/android/SDL_android.c src/video/android/SDL_androidevents.c src/hidapi/android/hid.cpp)
+    set(path "${SDL_SRC}/${f}")
+    file(READ "${path}" content)
+    string(REPLACE "org_libsdl_app_" "org_libsdl_appsoh_" content "${content}")
+    string(REGEX REPLACE "org_libsdl_app([^s_a-zA-Z0-9])" "org_libsdl_appsoh\\1" content "${content}")
+    string(REPLACE "org/libsdl/app/" "org/libsdl/appsoh/" content "${content}")
+    file(WRITE "${path}" "${content}")
+endforeach()
