diff --git a/src/ship/port/mobile/MobileImpl.cpp b/src/ship/port/mobile/MobileImpl.cpp
index 839343b..da3082e 100644
--- a/src/ship/port/mobile/MobileImpl.cpp
+++ b/src/ship/port/mobile/MobileImpl.cpp
@@ -212,4 +212,75 @@ void Ship::Mobile::SetFirstPersonAimingActive(bool active) {
     env->CallVoidMethod(javaObject, method, (jboolean)active);
 }
 
+// ---------------------------------------------------------------------------------------------------------------------
+// RomCore embedding. The host (RomCore) owns the loading screen, the menu, notices and error panels; SoH only renders the game.
+// ---------------------------------------------------------------------------------------------------------------------
+#include <chrono>
+#include <cstdlib>
+#include <thread>
+
+bool Ship::Mobile::RomCoreEmbedded() {
+    static const bool value = [] {
+        const char* env = std::getenv("ROMCORE_EMBED");
+        return env != nullptr && env[0] != '\0' && env[0] != '0';
+    }();
+    return value;
+}
+
+void Ship::Mobile::RomCoreEvent(int kind, const std::string& a, const std::string& b) {
+    JNIEnv* env = (JNIEnv*)SDL_AndroidGetJNIEnv();
+    jobject activity = (jobject)SDL_AndroidGetActivity();
+    if (env == nullptr || activity == nullptr) {
+        return;
+    }
+    jclass cls = env->GetObjectClass(activity);
+    jmethodID method =
+        cls != nullptr ? env->GetMethodID(cls, "onRomCoreEvent", "(ILjava/lang/String;Ljava/lang/String;)V") : nullptr;
+    if (method != nullptr) {
+        jstring ja = env->NewStringUTF(a.c_str());
+        jstring jb = env->NewStringUTF(b.c_str());
+        env->CallVoidMethod(activity, method, (jint)kind, ja, jb);
+        if (ja != nullptr) env->DeleteLocalRef(ja);
+        if (jb != nullptr) env->DeleteLocalRef(jb);
+    }
+    if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+    }
+    if (cls != nullptr) env->DeleteLocalRef(cls);
+    env->DeleteLocalRef(activity);
+}
+
+static std::atomic<bool> sRomCorePaused{false};
+
+extern "C" void JNICALL Java_com_dishii_soh_MainActivity_nativeRomCoreSetPaused(JNIEnv*, jobject, jboolean paused) {
+    sRomCorePaused = paused != JNI_FALSE;
+}
+
+// Release every virtual pad input (the host calls this when it takes the controller for its own menu).
+extern "C" void JNICALL Java_com_dishii_soh_MainActivity_nativeRomCoreReleaseAll(JNIEnv*, jobject) {
+    if (virtual_joystick == nullptr) {
+        return;
+    }
+    for (int i = 0; i < 15; i++) {
+        SDL_JoystickSetVirtualButton(virtual_joystick, i, 0);
+    }
+    for (int a = 0; a < 6; a++) {
+        SDL_JoystickSetVirtualAxis(virtual_joystick, a, a >= 4 ? -SDL_MAX_SINT16 : 0);
+    }
+}
+
+void Ship::Mobile::RomCoreOnGameFrame() {
+    if (!RomCoreEmbedded()) {
+        return;
+    }
+    static std::atomic<int> frames{0};
+    // "Ready" = the game has presented a few frames (the first ones are the N64 logo boot).
+    if (frames.load() < 6 && ++frames == 6) {
+        RomCoreEvent(0, "", "");
+    }
+    while (sRomCorePaused.load()) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(8));
+    }
+}
+
 #endif
