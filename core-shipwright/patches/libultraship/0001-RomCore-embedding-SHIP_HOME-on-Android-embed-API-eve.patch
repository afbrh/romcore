diff --git a/cmake/dependencies/android.cmake b/cmake/dependencies/android.cmake
index 36666a0..4c2b529 100644
--- a/cmake/dependencies/android.cmake
+++ b/cmake/dependencies/android.cmake
@@ -7,6 +7,7 @@ if (NOT ${SDL2_FOUND})
         SDL2
     GIT_REPOSITORY https://github.com/libsdl-org/SDL.git
     GIT_TAG release-2.32.10
+    PATCH_COMMAND ${CMAKE_COMMAND} -DSDL_SRC=<SOURCE_DIR> -P ${CMAKE_CURRENT_LIST_DIR}/patches/romcore-sdl2-java-package.cmake
     )
