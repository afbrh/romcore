+// RomCore embedding: the host shows the loading screen / error panel; SoH shows nothing while it prepares its game files.
+[[noreturn]] static void RomCoreFatal(const std::string& title, const std::string& message) {
+    Ship::Mobile::RomCoreEvent(2, title, message);
+    // The host closes the game (ends this process) once the user dismisses its error panel.
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+    }
+}
+
+static void RomCoreExtract(const std::string& installPath, const std::string& dataPath, const std::string& appShortName) {
+    namespace fs = std::filesystem;
+    auto o2rExists = [&]() {
+        return fs::exists(Ship::Context::LocateFileAcrossAppDirs("oot-mq.o2r", appShortName)) ||
+               fs::exists(Ship::Context::LocateFileAcrossAppDirs("oot.o2r", appShortName));
+    };
+    if (!fs::exists(dataPath + "/soh.o2r")) {
+        RomCoreFatal("Ocarina of Time", "The Ship of Harkinian core is missing its soh.o2r asset archive.");
+    }
+    if (o2rExists()) {
+        return;
+    }
+    const char* rom = std::getenv("ROMCORE_SOH_ROM");
+    if (rom == nullptr || rom[0] == '\0') {
+        RomCoreFatal("Ocarina of Time", "No ROM was passed to the Ship of Harkinian core.");
+    }
+    Extractor extract;
+    if (!extract.RunFileStandalone(rom)) {
+        RomCoreFatal("Ocarina of Time",
+                     "This file is not a supported Ocarina of Time ROM. Use a .z64 / .n64 / .v64 dump of the NTSC-U "
+                     "(1.0, 1.1, 1.2), PAL or Master Quest release.");
+    }
+    std::atomic<size_t> count{ 0 };
+    std::atomic<size_t> total{ 0 };
+    std::atomic<bool> done{ false };
+    std::thread worker([&]() {
+        extract.CallZapd(installPath, dataPath, &count, &total);
+        done = true;
+    });
+    int lastPercent = -1;
+    while (!done) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(250));
+        const size_t t = total.load();
+        const int percent = t > 0 ? (int)(count.load() * 100 / t) : 0;
+        if (percent != lastPercent) {
+            lastPercent = percent;
+            Ship::Mobile::RomCoreEvent(3, "Preparing Ocarina of Time (first launch only) " + std::to_string(percent) + "%",
+                                       std::to_string(percent / 100.0f));
+        }
+    }
+    worker.join();
+    if (!o2rExists()) {
+        RomCoreFatal("Ocarina of Time", "The game files could not be created from this ROM.");
+    }
+}
