 void Extractor::ShowErrorBox(const char* title, const char* text) {
+#ifdef __ANDROID__
+    if (Ship::Mobile::RomCoreEmbedded()) {
+        // RomCore shows its own error panel; wait here until the host closes the game.
+        Ship::Mobile::RomCoreEvent(2, title, text);
+        for (;;) {
+            std::this_thread::sleep_for(std::chrono::seconds(1));
+        }
+    }
+#endif
