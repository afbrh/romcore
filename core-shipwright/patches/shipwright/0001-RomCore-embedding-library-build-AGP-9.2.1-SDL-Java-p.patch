diff --git a/Android/app/consumer-rules.pro b/Android/app/consumer-rules.pro
new file mode 100644
index 000000000..3af5feb6b
--- /dev/null
+++ b/Android/app/consumer-rules.pro
@@ -0,0 +1,4 @@
+# RomCore: the embedding app minifies even debug builds. Everything below is called from native code (JNI) by name, or registers its
+# natives by name (SDL's JNI_OnLoad register_methods), so it must keep its exact names.
+-keep class org.libsdl.appsoh.** { *; }
+-keep class com.dishii.soh.** { *; }
diff --git a/Android/app/src/main/java/com/dishii/soh/MainActivity.java b/Android/app/src/main/java/com/dishii/soh/MainActivity.java
index 4f7a6c920..19e4ecaa0 100644
--- a/Android/app/src/main/java/com/dishii/soh/MainActivity.java
+++ b/Android/app/src/main/java/com/dishii/soh/MainActivity.java
@@ -1,6 +1,6 @@
 
 package com.dishii.soh;
-import org.libsdl.app.SDLActivity;
+import org.libsdl.appsoh.SDLActivity;
 
 import android.content.Context;
 import android.content.Intent;
@@ -52,6 +52,8 @@ public class MainActivity extends SDLActivity{
     SharedPreferences preferences;
     private static final CountDownLatch setupLatch = new CountDownLatch(1);
     private volatile boolean mIsAiming = false;
+    // library builds have no BuildConfig.VERSION_CODE; keep in step with versionCode in app/build.gradle
+    private static final int APP_VERSION_CODE = 10;
     private static final int COPY_BUFFER_SIZE = 65536;
     private static final int RUMBLE_MAX_DURATION_MS = 5000;
 
@@ -65,6 +67,16 @@ public class MainActivity extends SDLActivity{
 
         preferences = getSharedPreferences("com.dishii.soh.prefs", Context.MODE_PRIVATE);
 
+        if (isRomCoreEmbedded()) {
+            // RomCore embedding: the host prepares the data directory (soh.o2r, assets/extractor, config) before this Activity
+            // starts, owns every pixel that is not the game, and feeds the one virtual pad. No permission flow, no setup
+            // dialog, no touch overlay.
+            setupLatch.countDown();
+            attachController();
+            Log.i("SoH", "onCreate complete (RomCore embedded)");
+            return;
+        }
+
         Log.i("SoH", "hasStoragePermission=" + hasStoragePermission());
 
         // Check if storage permissions are granted
@@ -81,6 +93,18 @@ public class MainActivity extends SDLActivity{
         Log.i("SoH", "onCreate complete");
     }
 
+    /** RomCore subclasses return true: no overlay, no setup/permission flow, no Java dialogs. */
+    protected boolean isRomCoreEmbedded() {
+        return false;
+    }
+
+    /** Native -> host events (RomCore): 0 ready, 1 notice(a), 2 fatal(a=title, b=message), 3 progress(a). Default: ignore. */
+    public void onRomCoreEvent(int kind, String a, String b) {
+    }
+
+    public native void nativeRomCoreSetPaused(boolean paused);
+    public native void nativeRomCoreReleaseAll();
+
     public static void waitForSetupFromNative() {
         try {
             setupLatch.await();  // Block until setup is complete
@@ -90,7 +114,7 @@ public class MainActivity extends SDLActivity{
     }
 
     private void doVersionCheck(){
-        int currentVersion = BuildConfig.VERSION_CODE;
+        int currentVersion = APP_VERSION_CODE;
         int storedVersion = preferences.getInt("appVersion", currentVersion);
 
         if (currentVersion > storedVersion) {
@@ -381,6 +405,11 @@ public class MainActivity extends SDLActivity{
     }
 
     public void showAlertDialog(String title, String message, String btn1, String btn2) {
+        if (isRomCoreEmbedded()) {
+            Log.w("SoH", "dialog suppressed (RomCore embedded): " + title + ": " + message);
+            nativeDialogResult(0);
+            return;
+        }
         runOnUiThread(() -> {
             AlertDialog.Builder builder = new AlertDialog.Builder(this)
                     .setTitle(title)
@@ -400,6 +429,9 @@ public class MainActivity extends SDLActivity{
     }
 
     public void openFilePicker() {
+        if (isRomCoreEmbedded()) {
+            return;
+        }
         Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
         intent.setType("*/*");
         runOnUiThread(() -> startActivityForResult(intent, 0));
