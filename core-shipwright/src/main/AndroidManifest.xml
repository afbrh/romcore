<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- Ship of Harkinian's own application attributes must not leak into (or clash inside) RomCore's merged manifest. -->
    <application tools:remove="android:hardwareAccelerated,android:requestLegacyExternalStorage">

        <!-- SDL hints the stock app sets through manifest meta-data; the core sets the ones it needs itself (ShipwrightActivity). -->
        <meta-data android:name="SDL_ENV.SDL_ANDROID_TRAP_BACK_BUTTON" tools:node="remove" />
        <meta-data android:name="SDL_ENV.SDL_IOS_ORIENTATIONS" tools:node="remove" />

        <!-- The stock launcher Activity (touch overlay, setup dialogs, ImGui menu) is dropped; RomCore's subclass replaces it. -->
        <activity android:name="com.dishii.soh.MainActivity" tools:node="remove" />

        <!-- The whole runtime lives in its own process so libsoh.so / libSDL2.so and their GL context never share an address space
             with the other RomCore cores. The process is ended on Close Game. -->
        <activity
            android:name="com.noryan.romcore.core.shipwright.ShipwrightActivity"
            android:process=":shipwright"
            android:taskAffinity="com.noryan.romcore.shipwright"
            android:launchMode="singleTask"
            android:exported="false"
            android:alwaysRetainTaskState="true"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density" />
    </application>
</manifest>
