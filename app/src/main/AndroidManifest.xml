<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets cores in other processes open ROMs by real path (SAF paths are otherwise unreadable). Optional. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Cores declare these with differing maxSdkVersion; the app's unrestricted declaration wins. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="replace" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="replace" />

    <!-- Android 11+ package visibility: lets the Settings > APPS list see apps that have a launcher icon. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        tools:replace="android:appCategory,android:isGame,android:name,android:icon,android:label,android:roundIcon,android:theme,android:allowBackup,android:supportsRtl"
        android:name=".RomCoreApp"
        android:allowBackup="false"
        android:appCategory="game"
        android:isGame="true"
        tools:remove="android:banner,android:fullBackupContent,android:dataExtractionRules,android:networkSecurityConfig,android:enableOnBackInvokedCallback"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RomCore">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.RomCore.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets RomCore be chosen as the device's home screen (Settings > Apps > Default apps > Home app). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
