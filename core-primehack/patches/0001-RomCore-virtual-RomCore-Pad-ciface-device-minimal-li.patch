+// SPDX-License-Identifier: GPL-2.0-or-later
+
+package com.noryan.romcore.core.primehack.jni.features.input.model
+
+import androidx.annotation.Keep
+
+/**
+ * RomCore integration: sets one input of the virtual ciface device "RomCore/0/RomCore Pad"
+ * (see ROMCORE_INPUT_NAMES in ControllerInterface/Android/Android.cpp for the index table).
+ */
+@Keep
+object RomCoreInput {
+    const val A = 0; const val B = 1; const val X = 2; const val Y = 3
+    const val L1 = 4; const val R1 = 5; const val L2 = 6; const val R2 = 7
+    const val L3 = 8; const val R3 = 9; const val START = 10; const val SELECT = 11
+    const val UP = 12; const val DOWN = 13; const val LEFT = 14; const val RIGHT = 15; const val HOME = 16
+    const val LS_UP = 17; const val LS_DOWN = 18; const val LS_LEFT = 19; const val LS_RIGHT = 20
+    const val RS_UP = 21; const val RS_DOWN = 22; const val RS_LEFT = 23; const val RS_RIGHT = 24
+    const val L_TRIGGER = 25; const val R_TRIGGER = 26
+    const val GYRO_UP = 27; const val GYRO_DOWN = 28; const val GYRO_LEFT = 29; const val GYRO_RIGHT = 30
+    const val COUNT = 31
+
+    @JvmStatic
+    external fun nativeSet(index: Int, value: Double)
+
+    @JvmStatic
+    fun set(index: Int, value: Double) = nativeSet(index, value)
+}
