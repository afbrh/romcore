 #include <string>
 #include <unordered_map>
 #include <utility>
@@ -1020,6 +1021,77 @@ void InputBackend::RemoveDevice(jint device_id)
   s_device_id_to_device_qualifier.erase(device_id);
 }
 
+
+// ---------------------------------------------------------------------------------------------
+// RomCore integration: virtual "RomCore Pad" device.
+//
+// RomCore's shared input layer (InputRouter) translates the physical controller into canonical
+// Nintendo-labelled buttons/axes and hands them to the core through CoreSession.injectButton/
+// injectAxis. PrimeHack's camera/beam/visor groups can only be driven through ciface expressions
+// (the InputOverrider only covers stock GC/Wii controls), so canonical input is exposed to ciface
+// as this fixed device: the generated GCPadNew.ini / WiimoteNew.ini simply bind to it and stay
+// identical on every handheld. Source "RomCore", id 0 => qualifier `RomCore/0/RomCore Pad`.
+// ---------------------------------------------------------------------------------------------
+constexpr const char* ROMCORE_INPUT_NAMES[] = {
+    // 0..16 buttons
+    "A", "B", "X", "Y", "L1", "R1", "L2", "R2", "L3", "R3", "Start", "Select", "Up", "Down", "Left",
+    "Right", "Home",
+    // 17..30 analog (0..1 each)
+    "LS Up", "LS Down", "LS Left", "LS Right", "RS Up", "RS Down", "RS Left", "RS Right",
+    "L Trigger", "R Trigger", "Gyro Up", "Gyro Down", "Gyro Left", "Gyro Right"};
+constexpr int ROMCORE_INPUT_COUNT = sizeof(ROMCORE_INPUT_NAMES) / sizeof(ROMCORE_INPUT_NAMES[0]);
+
+class RomCoreInput final : public Core::Device::Input
+{
+public:
+  explicit RomCoreInput(const char* name) : m_name(name) {}
+  std::string GetName() const override { return m_name; }
+  ControlState GetState() const override { return m_state.load(std::memory_order_relaxed); }
+  void SetState(ControlState state) { m_state.store(state, std::memory_order_relaxed); }
+
+private:
+  std::string m_name;
+  std::atomic<ControlState> m_state = 0;
+};
+
+class RomCoreDevice final : public Core::Device
+{
+public:
+  RomCoreDevice()
+  {
+    for (int i = 0; i < ROMCORE_INPUT_COUNT; ++i)
+    {
+      auto* input = new RomCoreInput(ROMCORE_INPUT_NAMES[i]);
+      m_inputs[i] = input;
+      AddInput(input);
+    }
+  }
+  std::string GetName() const override { return "RomCore Pad"; }
+  std::string GetSource() const override { return "RomCore"; }
+  int GetSortPriority() const override { return 1; }
+  void Set(int index, ControlState value)
+  {
+    if (index >= 0 && index < ROMCORE_INPUT_COUNT)
+      m_inputs[index]->SetState(value);
+  }
+
+private:
+  RomCoreInput* m_inputs[ROMCORE_INPUT_COUNT]{};
+};
+
+std::mutex s_romcore_mutex;
+std::shared_ptr<RomCoreDevice> s_romcore_device;
+double s_romcore_pending[ROMCORE_INPUT_COUNT]{};
+
+void AddRomCoreDevice()
+{
+  std::lock_guard lock(s_romcore_mutex);
+  s_romcore_device = std::make_shared<RomCoreDevice>();
+  for (int i = 0; i < ROMCORE_INPUT_COUNT; ++i)
+    s_romcore_device->Set(i, s_romcore_pending[i]);
+  g_controller_interface.AddDevice(s_romcore_device);
+}
+
 void InputBackend::PopulateDevices()
 {
   INFO_LOG_FMT(CONTROLLERINTERFACE, "Android populating devices");
@@ -1036,6 +1108,7 @@ void InputBackend::PopulateDevices()
   env->DeleteLocalRef(device_ids_array);
 
   AddSensorDevice(env);
+  AddRomCoreDevice();
 }
 
 }  // namespace ciface::Android
@@ -1220,3 +1293,19 @@ Java_com_noryan_romcore_core_primehack_jni_features_input_model_ControllerInterf
   return CoreDeviceToJava(env, g_controller_interface.FindDevice(qualifier));
 }
 }
+
+extern "C" {
+
+// RomCore integration: RomCoreInput.set(index, value) — see ROMCORE_INPUT_NAMES for the index table.
+JNIEXPORT void JNICALL
+Java_com_noryan_romcore_core_primehack_jni_features_input_model_RomCoreInput_nativeSet(
+    JNIEnv*, jclass, jint index, jdouble value)
+{
+  if (index < 0 || index >= ciface::Android::ROMCORE_INPUT_COUNT)
+    return;
+  std::lock_guard lock(ciface::Android::s_romcore_mutex);
+  ciface::Android::s_romcore_pending[index] = value;
+  if (ciface::Android::s_romcore_device)
+    ciface::Android::s_romcore_device->Set(index, value);
+}
+}
