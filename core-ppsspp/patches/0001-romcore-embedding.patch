From db7815f1984bce4fc952347a4975b30e0234e0e3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 13:06:32 -0500
Subject: [PATCH] RomCore embedding: suppress pause menu/MainScreen, memstick
 in ext files dir, pause/state JNI

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 Core/Config.cpp                              |  3 ++
 UI/EmuScreen.cpp                             | 30 +++++++++++------
 UI/NativeApp.cpp                             |  5 +++
 android/jni/app-android.cpp                  | 34 ++++++++++++++++++++
 android/src/org/ppsspp/ppsspp/NativeApp.java |  4 +++
 5 files changed, 66 insertions(+), 10 deletions(-)

diff --git a/Core/Config.cpp b/Core/Config.cpp
index 4f7f32c..e753351 100644
--- a/Core/Config.cpp
+++ b/Core/Config.cpp
@@ -841,6 +841,9 @@ static const ConfigSetting soundSettings[] = {
 };
 
 static bool DefaultShowTouchControls() {
+#ifdef ROMCORE
+	return false;  // RomCore routes physical controllers (and its own overlay) itself.
+#endif
 	switch (System_GetPropertyInt(SYSPROP_DEVICE_TYPE)) {
 	case DEVICE_TYPE_MOBILE:
 		return !KeyMap::HasBuiltinController(System_GetProperty(SYSPROP_NAME));
diff --git a/UI/EmuScreen.cpp b/UI/EmuScreen.cpp
index 73ba801..d3f8138 100644
--- a/UI/EmuScreen.cpp
+++ b/UI/EmuScreen.cpp
@@ -81,6 +81,16 @@ using namespace std::placeholders;
 #include "UI/BackgroundAudio.h"
 #include "UI/GamepadEmu.h"
 #include "UI/PauseScreen.h"
+
+// RomCore embedding: PPSSPP's own pause menu and game browser are suppressed; the host app's shared
+// in-game menu replaces them, and leaving a game ends the process's activity instead of showing MainScreen.
+#ifdef ROMCORE
+#define ROMCORE_PUSH_PAUSE() do { } while (0)
+#define ROMCORE_GO_MAIN() System_ExitApp()
+#else
+#define ROMCORE_PUSH_PAUSE() screenManager()->push(new GamePauseScreen(gamePath_, bootPending_))
+#define ROMCORE_GO_MAIN() screenManager()->switchScreen(new MainScreen())
+#endif
 #include "UI/LoadStateConfirmScreen.h"
 #include "UI/MainScreen.h"
 #include "UI/Background.h"
@@ -180,7 +190,7 @@ bool EmuScreen::bootAllowStorage(const Path &filename) {
 
 	case PERMISSION_STATUS_DENIED:
 		if (!bootPending_) {
-			screenManager()->switchScreen(new MainScreen());
+			ROMCORE_GO_MAIN();
 		}
 		return false;
 
@@ -380,7 +390,7 @@ void EmuScreen::bootComplete() {
 		AutoLoadSaveState();
 	}
 
-#ifndef MOBILE_DEVICE
+#if !defined(MOBILE_DEVICE) && !defined(ROMCORE)
 	if (g_Config.bFirstRun) {
 		g_OSD.Show(OSDType::MESSAGE_INFO, sc->T("PressESC", "Press ESC to open the pause menu"));
 	}
@@ -504,7 +514,7 @@ void EmuScreen::dialogFinished(const Screen *dialog, DialogResult result) {
 	// DR_CANCEL/DR_BACK means clicked on "continue", DR_OK means clicked on "back to menu",
 	// DR_YES means a message sent to PauseMenu by System_PostUIMessage.
 	if ((result == DR_OK || quit_) && !bootPending_) {
-		screenManager()->switchScreen(new MainScreen());
+		ROMCORE_GO_MAIN();
 		quit_ = false;
 	} else {
 		RecreateViews();
@@ -535,7 +545,7 @@ void EmuScreen::sendMessage(UIMessage message, const char *value) {
 	// External commands, like from the Windows UI.
 	// This happens on the main thread.
 	if (message == UIMessage::REQUEST_GAME_PAUSE && screenManager()->topScreen() == this) {
-		screenManager()->push(new GamePauseScreen(gamePath_, bootPending_));
+		ROMCORE_PUSH_PAUSE();
 	} else if (message == UIMessage::REQUEST_GAME_STOP) {
 		// We will push MainScreen in update().
 		if (bootPending_) {
@@ -551,7 +561,7 @@ void EmuScreen::sendMessage(UIMessage message, const char *value) {
 			INFO_LOG(Log::Loader, "REQUEST_GAME_STOP: running exit callback before shutdown.");
 		} else {
 			// No callback (or already in flight, or core not running) - the destructor will take care of shutting down.
-			screenManager()->switchScreen(new MainScreen());
+			ROMCORE_GO_MAIN();
 		}
 	} else if (message == UIMessage::REQUEST_GAME_RESET) {
 		if (bootPending_) {
@@ -570,7 +580,7 @@ void EmuScreen::sendMessage(UIMessage message, const char *value) {
 		if (!PSP_InitStart(PSP_CoreParameter())) {
 			bootPending_ = false;
 			WARN_LOG(Log::Loader, "Error resetting");
-			screenManager()->switchScreen(new MainScreen());
+			ROMCORE_GO_MAIN();
 			return;
 		}
 	} else if (message == UIMessage::REQUEST_GAME_BOOT) {
@@ -664,7 +674,7 @@ void EmuScreen::sendMessage(UIMessage message, const char *value) {
 				// use this as the fallback way to get into the menu.
 				// Don't do it on the first resume though, in case we launch directly into emuscreen, like from a frontend - see #18926
 				if (!equals(value, "first")) {
-					screenManager()->push(new GamePauseScreen(gamePath_, bootPending_));
+					ROMCORE_PUSH_PAUSE();
 				}
 			}
 		}
@@ -1448,7 +1458,7 @@ void EmuScreen::update() {
 
 	if (pauseTrigger_) {
 		pauseTrigger_ = false;
-		screenManager()->push(new GamePauseScreen(gamePath_, bootPending_));
+		ROMCORE_PUSH_PAUSE();
 	}
 
 	if (!PSP_IsInited())
@@ -1497,7 +1507,7 @@ bool EmuScreen::checkPowerDown() {
 	// Also for REQUEST_STOP.
 	if (coreState == CORE_POWERDOWN && PSP_GetBootState() == BootState::Complete && !bootPending_) {
 		INFO_LOG(Log::System, "SELF-POWERDOWN!");
-		screenManager()->switchScreen(new MainScreen());
+		ROMCORE_GO_MAIN();
 		return true;
 	}
 	return false;
@@ -1809,7 +1819,7 @@ ScreenRenderFlags EmuScreen::RunEmulation(bool skipBufferEffects) {
 			if (!PSP_InitStart(PSP_CoreParameter())) {
 				bootPending_ = false;
 				WARN_LOG(Log::Loader, "Error resetting");
-				screenManager()->switchScreen(new MainScreen());
+				ROMCORE_GO_MAIN();
 			}
 		}
 	}
diff --git a/UI/NativeApp.cpp b/UI/NativeApp.cpp
index d7e397d..8978036 100644
--- a/UI/NativeApp.cpp
+++ b/UI/NativeApp.cpp
@@ -589,6 +589,11 @@ void NativeInit(int argc, const char *argv[], const CommandLineOptions &cmdLineO
 	if (System_GetPropertyBool(SYSPROP_ANDROID_SCOPED_STORAGE)) {
 		// There's no sensible default directory. Let the user browse for files.
 		g_Config.defaultCurrentDirectory.clear();
+#ifdef ROMCORE
+		// RomCore embedding: never show the memstick setup UI; use the app-private external dir.
+		extern std::string g_extFilesDir;
+		g_Config.memStickDirectory = Path(g_extFilesDir);
+#endif
 	} else {
 		g_Config.memStickDirectory = Path(external_dir);
 		g_Config.defaultCurrentDirectory = Path(external_dir);
diff --git a/android/jni/app-android.cpp b/android/jni/app-android.cpp
index a082653..7f7c37f 100644
--- a/android/jni/app-android.cpp
+++ b/android/jni/app-android.cpp
@@ -98,6 +98,8 @@ struct JNIEnv {};
 #include "Core/Loaders.h"
 #include "Core/KeyMap.h"
 #include "Core/System.h"
+#include "Core/Core.h"
+#include "Core/SaveState.h"
 #include "Core/EmuThread.h"
 #include "Core/HLE/sceUsbCam.h"
 #include "Core/HLE/sceUsbGps.h"
@@ -577,6 +579,38 @@ extern "C" jboolean Java_org_ppsspp_ppsspp_NativeApp_isLandscape(JNIEnv *env, jc
 	return landscape;
 }
 
+
+// ---- RomCore embedding additions ----------------------------------------------------------------
+// Pause/resume without PPSSPP's pause menu (same mechanism as VIRTKEY_PAUSE_NO_MENU).
+extern "C" void Java_org_ppsspp_ppsspp_NativeApp_romcorePause(JNIEnv *env, jclass, jboolean pause) {
+	if (pause) {
+		if (!Core_IsStepping())
+			Core_Break(BreakReason::UIPause);
+	} else {
+		if (Core_IsStepping() && Core_BreakReason() == BreakReason::UIPause)
+			Core_Resume();
+	}
+}
+
+// Async state save/load to an explicit file. Poll romcoreStateStatus(): 0 = pending, 1 = ok, -1 = failed.
+static std::atomic<int> g_romcoreStateStatus{-1};
+
+extern "C" void Java_org_ppsspp_ppsspp_NativeApp_romcoreState(JNIEnv *env, jclass, jboolean save, jstring jpath) {
+	Path path(GetJavaString(env, jpath));
+	g_romcoreStateStatus = 0;
+	auto cb = [](SaveState::Status status, std::string_view message, std::string_view metadata) {
+		g_romcoreStateStatus = (status != SaveState::Status::FAILURE) ? 1 : -1;
+	};
+	if (save)
+		SaveState::Save(path, -1, cb);
+	else
+		SaveState::Load(path, -1, cb);
+}
+
+extern "C" jint Java_org_ppsspp_ppsspp_NativeApp_romcoreStateStatus(JNIEnv *env, jclass) {
+	return g_romcoreStateStatus.load();
+}
+
 // Allow the app to intercept the back button.
 extern "C" jboolean Java_org_ppsspp_ppsspp_NativeApp_isAtTopLevel(JNIEnv *env, jclass) {
 	return NativeIsAtTopLevel();
diff --git a/android/src/org/ppsspp/ppsspp/NativeApp.java b/android/src/org/ppsspp/ppsspp/NativeApp.java
index 3afe212..895aec2 100644
--- a/android/src/org/ppsspp/ppsspp/NativeApp.java
+++ b/android/src/org/ppsspp/ppsspp/NativeApp.java
@@ -50,6 +50,10 @@ public class NativeApp {
 
 	// These have Android semantics: Resume is always called on bootup, after init
 	public static native void pause();
+	// RomCore additions
+	public static native void romcorePause(boolean pause);
+	public static native void romcoreState(boolean save, String path);
+	public static native int romcoreStateStatus();
 	public static native void resume();
 
 	public static native void shutdown();
