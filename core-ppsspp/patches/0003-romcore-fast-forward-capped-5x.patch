+// Hold-to-run fast forward: runs at `multiplier` x the normal frame rate (clamped 1..5, never unthrottled). 1 = normal.
+extern std::atomic<int> g_romcoreFastForwardMultiplier;
+extern "C" void Java_org_ppsspp_ppsspp_NativeApp_romcoreFastForward(JNIEnv *env, jclass, jint multiplier) {
+	g_romcoreFastForwardMultiplier.store(std::clamp((int)multiplier, 1, 5));
+}
