diff --git a/src/dusk/romcore_embed.cpp b/src/dusk/romcore_embed.cpp
new file mode 100644
index 0000000000..bf55ad2397
--- /dev/null
+++ b/src/dusk/romcore_embed.cpp
@@ -0,0 +1,225 @@
+#include "dusk/romcore_embed.hpp"
+
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include <aurora/aurora.h>
+#include <aurora/gfx.h>
+
+#if defined(__ANDROID__)
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_system.h>
+#include <jni.h>
+
+#include "dusk/logging.h"
+#endif
+
+namespace dusk::romcore {
+
+bool enabled() noexcept {
+    static const bool value = [] {
+        const char* env = std::getenv("DUSK_ROMCORE_EMBED");
+        return env != nullptr && env[0] != '\0' && env[0] != '0';
+    }();
+    return value;
+}
+
+#if defined(__ANDROID__)
+namespace {
+
+// Event kinds understood by DuskActivity.onRomCoreEvent(int, String, String).
+constexpr int kEventReady = 0;
+constexpr int kEventNotice = 1;
+constexpr int kEventError = 2;
+
+void send_event(int kind, const std::string& a, const std::string& b) noexcept {
+    JNIEnv* env = static_cast<JNIEnv*>(SDL_GetAndroidJNIEnv());
+    jobject activity = static_cast<jobject>(SDL_GetAndroidActivity());
+    if (env == nullptr || activity == nullptr) {
+        return;
+    }
+    jclass cls = env->GetObjectClass(activity);
+    jmethodID method =
+        cls != nullptr ? env->GetMethodID(cls, "onRomCoreEvent", "(ILjava/lang/String;Ljava/lang/String;)V") : nullptr;
+    if (method != nullptr) {
+        jstring ja = env->NewStringUTF(a.c_str());
+        jstring jb = env->NewStringUTF(b.c_str());
+        env->CallVoidMethod(activity, method, static_cast<jint>(kind), ja, jb);
+        if (ja != nullptr) env->DeleteLocalRef(ja);
+        if (jb != nullptr) env->DeleteLocalRef(jb);
+    }
+    if (env->ExceptionCheck()) {
+        env->ExceptionClear();
+    }
+    if (cls != nullptr) env->DeleteLocalRef(cls);
+    env->DeleteLocalRef(activity);
+}
+
+// ---- virtual gamepad -------------------------------------------------------------------------------------------
+// RomCore's InputRouter delivers canonical pad state; it is exposed to the game as ONE SDL virtual gamepad so the
+// normal Aurora/Dusklight input path (port assignment, bindings, deadzones) is unchanged. The physical controller is
+// hidden from SDL by the Activity (events swallowed) and by SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT.
+constexpr Uint16 kVendor = 0x5243;   // "RC"
+constexpr Uint16 kProduct = 0x0001;
+
+std::mutex g_padMutex;
+SDL_Joystick* g_joystick = nullptr;
+SDL_JoystickID g_joystickId = 0;
+
+// Gamepad button -> virtual joystick button index. SDL assigns indices in the fixed order of
+// VIRTUAL_JoystickGetGamepadMapping (A B X Y BACK GUIDE START LSTICK RSTICK LSHOULDER RSHOULDER DPAD U D L R).
+constexpr SDL_GamepadButton kButtonOrder[] = {
+    SDL_GAMEPAD_BUTTON_SOUTH,          SDL_GAMEPAD_BUTTON_EAST,           SDL_GAMEPAD_BUTTON_WEST,
+    SDL_GAMEPAD_BUTTON_NORTH,          SDL_GAMEPAD_BUTTON_BACK,           SDL_GAMEPAD_BUTTON_START,
+    SDL_GAMEPAD_BUTTON_LEFT_STICK,     SDL_GAMEPAD_BUTTON_RIGHT_STICK,    SDL_GAMEPAD_BUTTON_LEFT_SHOULDER,
+    SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER, SDL_GAMEPAD_BUTTON_DPAD_UP,        SDL_GAMEPAD_BUTTON_DPAD_DOWN,
+    SDL_GAMEPAD_BUTTON_DPAD_LEFT,      SDL_GAMEPAD_BUTTON_DPAD_RIGHT,
+};
+constexpr int kButtonCount = sizeof(kButtonOrder) / sizeof(kButtonOrder[0]);
+
+// Last requested state, replayed when the joystick is (re)attached.
+bool g_buttonState[SDL_GAMEPAD_BUTTON_COUNT] = {};
+Sint16 g_axisState[SDL_GAMEPAD_AXIS_COUNT] = {0, 0, 0, 0, SDL_JOYSTICK_AXIS_MIN, SDL_JOYSTICK_AXIS_MIN};
+
+int button_index(int sdlButton) {
+    for (int i = 0; i < kButtonCount; ++i) {
+        if (static_cast<int>(kButtonOrder[i]) == sdlButton) return i;
+    }
+    return -1;
+}
+
+bool ensure_attached_locked() {
+    if (g_joystick != nullptr) return true;
+    if (!SDL_WasInit(SDL_INIT_JOYSTICK)) return false;
+
+    SDL_VirtualJoystickDesc desc;
+    SDL_INIT_INTERFACE(&desc);
+    desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+    desc.vendor_id = kVendor;
+    desc.product_id = kProduct;
+    desc.naxes = SDL_GAMEPAD_AXIS_COUNT;
+    desc.nbuttons = kButtonCount;
+    desc.name = "RomCore Pad";
+    for (const auto b : kButtonOrder) desc.button_mask |= (1u << static_cast<unsigned>(b));
+    for (int a = 0; a < SDL_GAMEPAD_AXIS_COUNT; ++a) desc.axis_mask |= (1u << static_cast<unsigned>(a));
+
+    g_joystickId = SDL_AttachVirtualJoystick(&desc);
+    if (g_joystickId == 0) {
+        DuskLog.warn("RomCore: SDL_AttachVirtualJoystick failed: {}", SDL_GetError());
+        return false;
+    }
+    g_joystick = SDL_OpenJoystick(g_joystickId);
+    if (g_joystick == nullptr) {
+        DuskLog.warn("RomCore: SDL_OpenJoystick(virtual) failed: {}", SDL_GetError());
+        SDL_DetachVirtualJoystick(g_joystickId);
+        g_joystickId = 0;
+        return false;
+    }
+    DuskLog.info("RomCore: virtual gamepad attached (instance {})", g_joystickId);
+    for (int i = 0; i < kButtonCount; ++i) {
+        SDL_SetJoystickVirtualButton(g_joystick, i, g_buttonState[static_cast<int>(kButtonOrder[i])]);
+    }
+    for (int a = 0; a < SDL_GAMEPAD_AXIS_COUNT; ++a) {
+        SDL_SetJoystickVirtualAxis(g_joystick, a, g_axisState[a]);
+    }
+    return true;
+}
+
+std::atomic<bool> g_readyFired{false};
+std::atomic<int> g_frames{0};
+int g_drawFrames = 0;
+constexpr uint32_t kMinDraws = 4;
+constexpr int kDrawFramesNeeded = 3;
+
+}  // namespace
+
+void on_frame() noexcept {
+    {
+        std::lock_guard lock(g_padMutex);
+        ensure_attached_locked();
+    }
+    const int frames = ++g_frames;
+    static const bool debug = std::getenv("DUSK_ROMCORE_DEBUG") != nullptr;
+    const AuroraStats* stats = aurora_get_stats();
+    const uint32_t draws = stats != nullptr ? stats->drawCallCount : 0;
+    if (debug && frames <= 600) {
+        DuskLog.info("RomCore frame {} draws={}", frames, draws);
+    }
+    if (g_readyFired.load()) {
+        return;
+    }
+    // "Ready" = the game has really put something on screen: several consecutive presented frames that each issued draw
+    // calls (the first frames are black while the DVD thread loads the logo scene).
+    g_drawFrames = draws >= kMinDraws ? g_drawFrames + 1 : 0;
+    if (g_drawFrames >= kDrawFramesNeeded && !g_readyFired.exchange(true)) {
+        DuskLog.info("RomCore: first visible frame at presented frame {}", frames);
+        send_event(kEventReady, "", "");
+    }
+}
+
+void notice(std::string_view text) noexcept {
+    DuskLog.info("RomCore notice: {}", text);
+    send_event(kEventNotice, std::string(text), "");
+}
+
+void fatal(std::string_view title, std::string_view message) noexcept {
+    DuskLog.error("RomCore fatal: {}: {}", title, message);
+    send_event(kEventError, std::string(title), std::string(message));
+    // The host closes the game (kills the process) when the user dismisses the panel; wait for that.
+    for (int i = 0; i < 6000; ++i) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    }
+}
+
+extern "C" {
+
+JNIEXPORT void JNICALL Java_dev_twilitrealm_dusk_DuskActivity_nativeRomCoreButton(
+    JNIEnv*, jclass, jint sdlButton, jboolean down) {
+    const int idx = button_index(sdlButton);
+    if (idx < 0) return;
+    std::lock_guard lock(g_padMutex);
+    g_buttonState[sdlButton] = down != JNI_FALSE;
+    if (g_joystick != nullptr) SDL_SetJoystickVirtualButton(g_joystick, idx, down != JNI_FALSE);
+}
+
+JNIEXPORT void JNICALL Java_dev_twilitrealm_dusk_DuskActivity_nativeRomCoreAxis(
+    JNIEnv*, jclass, jint sdlAxis, jint value) {
+    if (sdlAxis < 0 || sdlAxis >= SDL_GAMEPAD_AXIS_COUNT) return;
+    const int clamped = value < SDL_JOYSTICK_AXIS_MIN ? SDL_JOYSTICK_AXIS_MIN
+                                                      : (value > SDL_JOYSTICK_AXIS_MAX ? SDL_JOYSTICK_AXIS_MAX : value);
+    std::lock_guard lock(g_padMutex);
+    g_axisState[sdlAxis] = static_cast<Sint16>(clamped);
+    if (g_joystick != nullptr) SDL_SetJoystickVirtualAxis(g_joystick, sdlAxis, static_cast<Sint16>(clamped));
+}
+
+JNIEXPORT void JNICALL Java_dev_twilitrealm_dusk_DuskActivity_nativeRomCoreReleaseAll(JNIEnv*, jclass) {
+    std::lock_guard lock(g_padMutex);
+    for (int i = 0; i < SDL_GAMEPAD_BUTTON_COUNT; ++i) g_buttonState[i] = false;
+    for (int a = 0; a < SDL_GAMEPAD_AXIS_COUNT; ++a) {
+        g_axisState[a] = (a >= SDL_GAMEPAD_AXIS_LEFT_TRIGGER) ? SDL_JOYSTICK_AXIS_MIN : 0;
+    }
+    if (g_joystick == nullptr) return;
+    for (int i = 0; i < kButtonCount; ++i) SDL_SetJoystickVirtualButton(g_joystick, i, false);
+    for (int a = 0; a < SDL_GAMEPAD_AXIS_COUNT; ++a) SDL_SetJoystickVirtualAxis(g_joystick, a, g_axisState[a]);
+}
+
+JNIEXPORT void JNICALL Java_dev_twilitrealm_dusk_DuskActivity_nativeRomCoreSetPaused(
+    JNIEnv*, jclass, jboolean paused) {
+    aurora_set_host_paused(paused != JNI_FALSE);
+}
+
+}  // extern "C"
+
+#else  // !__ANDROID__
+
+void on_frame() noexcept {}
+void notice(std::string_view) noexcept {}
+void fatal(std::string_view, std::string_view) noexcept {}
+
+#endif
+
+}  // namespace dusk::romcore
diff --git a/src/dusk/romcore_embed.hpp b/src/dusk/romcore_embed.hpp
new file mode 100644
index 0000000000..6d24f3fa3b
--- /dev/null
+++ b/src/dusk/romcore_embed.hpp
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <string_view>
+
+// RomCore embedding layer (local patch, never upstreamed).
+//
+// When Dusklight runs inside the RomCore Android app (DuskActivity exports DUSK_ROMCORE_EMBED=1 before the native
+// library starts) RomCore owns EVERY pixel that is not the game: loading screen, overlays, toasts, dialogs, the
+// pause/Back menu, controller mapping. This module is the only seam between the two:
+//   * enabled()        gate used by the UI code to keep Dusklight's own menus/overlays/prelaunch/settings unreachable
+//   * on_frame()       per presented frame: virtual-gamepad housekeeping + "first frame" signal for the loading screen
+//   * notice()/fatal() text for RomCore's banner / blocking error panel (instead of Dusklight toasts / abort())
+//   * JNI entry points (dev.twilitrealm.dusk.DuskActivity.nativeRomCore*) that feed RomCore's canonical pad into an
+//     SDL virtual gamepad, pause the game while RomCore's menu is open and flush saves before the process is killed.
+namespace dusk::romcore {
+
+bool enabled() noexcept;
+
+// Called on the game thread right after aurora_end_frame().
+void on_frame() noexcept;
+
+// Transient message for RomCore's banner (Android: DuskActivity.onRomCoreEvent). Safe from any thread.
+void notice(std::string_view text) noexcept;
+
+// Blocking error for RomCore's error panel; waits (bounded) for the host to close the game, then returns so the caller
+// can abort. Safe from any thread.
+void fatal(std::string_view title, std::string_view message) noexcept;
+
+}  // namespace dusk::romcore
