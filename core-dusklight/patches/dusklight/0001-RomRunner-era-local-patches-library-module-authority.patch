diff --git a/platforms/android/app/src/main/java/com/twilitrealm/dusk/DuskActivity.java b/platforms/android/app/src/main/java/com/twilitrealm/dusk/DuskActivity.java
index 4c1d8d41eb..c9b982fd2c 100644
--- a/platforms/android/app/src/main/java/com/twilitrealm/dusk/DuskActivity.java
+++ b/platforms/android/app/src/main/java/com/twilitrealm/dusk/DuskActivity.java
@@ -17,9 +17,36 @@ public class DuskActivity extends BorealisActivity {
     @Override
     protected void onCreate(Bundle savedInstanceState) {
         extractBundledMods();
+        // RomRunner integration: "main" is loaded explicitly from a private-storage copy
+        // (extracted by DuskLightEmbeddedLauncher.ensureNativeLibInstalled before this Activity
+        // is even started) rather than via the standard Borealis getLibraries()/
+        // SDL.loadLibrary("main") mechanism below, which searches nativeLibraryDir — this
+        // module's own libmain.so is deliberately NOT packaged there (see
+        // borealis-application.gradle) because it shares its exact output filename with
+        // PrimeHack's own Dolphin-core libmain.so, also embedded in RomRunner; letting both into
+        // the same nativeLibraryDir would silently satisfy whichever core calls
+        // System.loadLibrary("main") first with the OTHER core's native code.
+        System.load(new File(getApplicationInfo().dataDir, "dusklight/libmain.so").getAbsolutePath());
         super.onCreate(savedInstanceState);
     }
 
+    @Override
+    protected String[] getLibraries() {
+        // Loaded explicitly above instead of via the standard mechanism — see onCreate().
+        return new String[0];
+    }
+
+    @Override
+    protected String getMainSharedObject() {
+        // RomRunner integration: the default implementation (SDLActivity.getMainSharedObject())
+        // returns getApplicationInfo().nativeLibraryDir + "/libmain.so" — RomRunner's actual
+        // nativeLibraryDir contains PrimeHack's own Dolphin-core libmain.so (see onCreate()'s
+        // comment), so that default would hand SDL_RunApp a dlsym(SDL_main) lookup against the
+        // WRONG native library entirely. Point it at the same explicit path already System.load()ed
+        // in onCreate() instead.
+        return new File(getApplicationInfo().dataDir, "dusklight/libmain.so").getAbsolutePath();
+    }
+
     // Bundled mod packages ship as APK assets, which the native loader cannot read directly;
     // mirror them into internal storage (the loader's CachePath/bundled_mods search dir)
     // before SDL_main starts.
diff --git a/platforms/android/build.gradle b/platforms/android/build.gradle
