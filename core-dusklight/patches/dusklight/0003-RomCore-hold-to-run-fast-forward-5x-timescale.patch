+// Hold-to-run Fast Forward: scales the game clock (aurora timescale; the sim runs up to 5x30 ticks/s) while the
+// frame limiter stays ON (we never touch turboMode), so presentation stays capped at video.maxFrameRate and the
+// speed is hard-capped at kFastForwardScale. Idempotent; off restores the exact previous scale.
+JNIEXPORT jboolean JNICALL Java_dev_twilitrealm_dusk_DuskActivity_nativeRomCoreSetFastForward(
+    JNIEnv*, jclass, jboolean on) {
+    static constexpr float kFastForwardScale = 5.0f;
+    static std::mutex m;
+    static bool active = false;
+    static float previous = 1.0f;
+    std::lock_guard lock(m);
+    if (on != JNI_FALSE) {
+        if (!active) {
+            previous = aurora_get_timescale();
+            if (previous <= 0.0f || previous > 1.0f) previous = 1.0f;
+            active = true;
+        }
+        aurora_set_timescale(kFastForwardScale);
+    } else if (active) {
+        aurora_set_timescale(previous);
+        active = false;
+    }
+    return JNI_TRUE;
+}
