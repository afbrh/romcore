diff --git a/lib/dolphin/card.cpp b/lib/dolphin/card.cpp
index d1eb5a0..910c585 100644
--- a/lib/dolphin/card.cpp
+++ b/lib/dolphin/card.cpp
@@ -1,5 +1,6 @@
 #include "dolphin/card.h"
 
+#include <cstdlib>
 #include <cstring>
 #include <filesystem>
 
@@ -70,6 +71,20 @@ std::filesystem::path get_card_full_path(const std::filesystem::path& path, cons
   }
 }
 
+
+// RomCore integration: embedders (the Android port inside RomCore) can relocate the memory-card storage (GCI folders /
+// raw images and the save-manager data next to them) away from the user directory by exporting AURORA_CARD_DIR
+// before the engine starts, so game saves live in a portable folder while config/caches stay local.
+std::filesystem::path card_base_dir() {
+  if (const char* env = std::getenv("AURORA_CARD_DIR"); env != nullptr && env[0] != '\0') {
+    return aurora::io::fs_path_from_string(env);
+  }
+  if (aurora::g_config.userPath != nullptr) {
+    return aurora::io::fs_path_from_string(aurora::g_config.userPath);
+  }
+  return std::filesystem::current_path();
+}
+
 AuroraCardType selected_card_type() { return CARD_USE_GCI_FOLDER ? AURORA_CARD_GCI_DIRECTORY : AURORA_CARD_RAW_IMAGE; }
 
 size_t copy_path(const std::filesystem::path& path, char* buffer, const size_t capacity) {
@@ -111,12 +126,7 @@ size_t aurora_card_get_path(const char* gameName, const AuroraCardType type, con
     return copy_path(cardPaths[channel], buffer, capacity);
   }
 
-  std::filesystem::path basePath;
-  if (aurora::g_config.userPath != nullptr) {
-    basePath = aurora::io::fs_path_from_string(aurora::g_config.userPath);
-  } else {
-    basePath = std::filesystem::current_path();
-  }
+  const std::filesystem::path basePath = card_base_dir();
   return copy_path(get_card_full_path(basePath, gameName, type, static_cast<aurora::card::ECardSlot>(channel)), buffer,
                    capacity);
 }
@@ -310,11 +320,7 @@ void CARDInit(const char* game, const char* maker) {
     CardChannels[i]->InitCard(game, maker);
   }
 
-  std::filesystem::path cardWorkingDir;
-  if (aurora::g_config.userPath != nullptr)
-    cardWorkingDir = aurora::io::fs_path_from_string(aurora::g_config.userPath);
-  else
-    cardWorkingDir = std::filesystem::current_path();
+  const std::filesystem::path cardWorkingDir = card_base_dir();
 
   bool loadedCard = false;
 
diff --git a/lib/window.cpp b/lib/window.cpp
index 2a4aadf..e9ad068 100644
--- a/lib/window.cpp
+++ b/lib/window.cpp
@@ -55,6 +55,9 @@ std::atomic_bool g_surfaceReady = false;
 std::atomic_bool g_surfaceReady = true;
 #endif
 bool g_lastPaused = false;
+// RomCore integration: embedder-requested pause (in-game menu open), see aurora_set_host_paused().
+std::atomic_bool g_hostPaused = false;
+Uint32 g_hostPauseEvent = 0;
 bool g_gotFocus = false;
 
 void retain_event_strings(SDL_Event& event) {
@@ -489,6 +492,9 @@ SDL_Window* get_sdl_window() { return g_window; }
 SDL_Renderer* get_sdl_renderer() { return g_renderer; }
 
 bool is_paused() noexcept {
+  if (g_hostPaused.load(std::memory_order_acquire)) {
+    return true;
+  }
   if (!is_presentable()) {
     return true;
   }
@@ -597,3 +603,20 @@ extern "C" JNIEXPORT void JNICALL Java_dev_encounter_aurora_AuroraSurface_native
   aurora::window::set_surface_ready(ready == JNI_TRUE);
 }
 #endif
+
+namespace aurora::window {
+// RomCore integration: pause/resume requested by the embedding app (any thread). The main loop treats it exactly like
+// "window lost focus": the game clock stops, audio is paused (AURORA_PAUSED) and no frame is drawn. A registered SDL
+// event wakes the loop so it notices the change even while blocked in SDL_WaitEvent.
+void set_host_paused(bool paused) noexcept {
+  g_hostPaused.store(paused, std::memory_order_release);
+  if (g_hostPauseEvent == 0) {
+    g_hostPauseEvent = SDL_RegisterEvents(1);
+  }
+  if (g_hostPauseEvent != 0 && g_hostPauseEvent != static_cast<Uint32>(-1)) {
+    SDL_Event event{};
+    event.type = g_hostPauseEvent;
+    SDL_PushEvent(&event);
+  }
+}
+} // namespace aurora::window
diff --git a/lib/window.hpp b/lib/window.hpp
