# RomCore Game Boy border crop (single pass, nearest, to the viewport): the plain Game Boy picture. GPL-3.0-or-later, same as RomCore.
shaders = 1
shader0 = romcore-gbcrop.glsl
filter_linear0 = false
wrap_mode0 = clamp_to_edge
mipmap_input0 = false
alias0 = ""
float_framebuffer0 = false
srgb_framebuffer0 = false
scale_type0 = viewport
scale0 = 1.0
