From 6c620943ff774d78010b18a4faaf3310184b35ba Mon Sep 17 00:00:00 2001
From: Ry <ry@Rys-MacBook-Pro.local>
Date: Tue, 13 Oct 2026 23:24:13 -0500
Subject: [PATCH 2/2] RomCore: ROMCORE_NAND_ROOT env points the Wii NAND at the
 portable save folder before Config::Init (no second NAND under the app dir,
 SYSCONF layer read from the real NAND); crash-recovery restore after config
 load

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 Source/Core/UICommon/UICommon.cpp | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/Source/Core/UICommon/UICommon.cpp b/Source/Core/UICommon/UICommon.cpp
index 51e0798..b1cb023 100644
--- a/Source/Core/UICommon/UICommon.cpp
+++ b/Source/Core/UICommon/UICommon.cpp
@@ -3,6 +3,7 @@
 
 #include "UICommon/UICommon.h"
 
+#include <cstdlib>
 #include <algorithm>
 #include <clocale>
 #include <cmath>
@@ -125,7 +126,12 @@ static void RefreshConfig()
 
 void Init()
 {
-  Core::RestoreWiiSettings(Core::RestoreReason::CrashRecovery);
+  // RomCore: Config::Init() loads the SYSCONF config layer from the "configured" Wii NAND, which at this point would still be
+  // the default <user dir>/Wii (NANDRootPath is only applied by InitCustomPaths() once Dolphin.ini is loaded): that created an
+  // empty second NAND in the app's private folder on every launch and read the Wii settings from it instead of the real NAND
+  // in the portable save folder. The host exports the NAND root before native init.
+  if (const char* romcore_nand = std::getenv("ROMCORE_NAND_ROOT"); romcore_nand != nullptr && *romcore_nand != '\0')
+    File::SetUserPath(D_WIIROOT_IDX, romcore_nand);
 
   Config::Init();
   const auto config_changed_callback = [] {
@@ -134,6 +140,11 @@ void Init()
   };
   s_config_changed_callback_id = Config::AddConfigChangedCallback(config_changed_callback);
   Config::AddLayer(ConfigLoaders::GenerateBaseConfigLoader());
+
+  // RomCore: the Wii NAND root (Dolphin.ini [General] NANDRootPath) lives in the portable save folder. InitCustomPaths() has
+  // pointed D_WIIROOT_IDX there by now; running the crash-recovery restore BEFORE the config was loaded created an empty
+  // NAND skeleton (fst.bin, shared2/sys/SYSCONF) at the default <user dir>/Wii on every launch.
+  Core::RestoreWiiSettings(Core::RestoreReason::CrashRecovery);
   SConfig::Init();
   g_Config.Init();
   Discord::Init();
-- 
