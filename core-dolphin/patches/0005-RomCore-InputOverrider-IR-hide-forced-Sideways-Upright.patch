From dcfdc5dccc5cdf63b87833b2236394e5e6118384 Mon Sep 17 00:00:00 2001
From: Ry <ry@Rys-MacBook-Pro.local>
Date: Thu, 15 Oct 2026 06:52:37 -0500
Subject: [PATCH] RomCore: InputOverrider IR-hide + forced Sideways/Upright
 orientation controls (Metroid: Other M profile)

---
 Source/Core/Core/HW/WiimoteEmu/WiimoteEmu.cpp     | 15 +++++++++++++--
 .../ControllerEmu/ControlGroup/Cursor.cpp         | 10 ++++++++++
 .../ControllerEmu/ControlGroup/Cursor.h           |  2 ++
 .../ControllerInterface/Touch/InputOverrider.cpp  |  5 +++++
 .../ControllerInterface/Touch/InputOverrider.h    |  7 ++++++-
 5 files changed, 36 insertions(+), 3 deletions(-)

diff --git a/Source/Core/Core/HW/WiimoteEmu/WiimoteEmu.cpp b/Source/Core/Core/HW/WiimoteEmu/WiimoteEmu.cpp
index bbbea66..7b0f4d9 100644
--- a/Source/Core/Core/HW/WiimoteEmu/WiimoteEmu.cpp
+++ b/Source/Core/Core/HW/WiimoteEmu/WiimoteEmu.cpp
@@ -807,18 +807,29 @@ Extension* Wiimote::GetActiveExtension() const
   return static_cast<Extension*>(m_attachments->GetAttachmentList()[m_active_extension].get());
 }
 
+static constexpr const char* ROMCORE_ORIENT_GROUP = "RomCoreOrient";
+
 bool Wiimote::IsSideways() const
 {
   const bool sideways_modifier_toggle = m_hotkeys->GetSettingsModifier()[0];
   const bool sideways_modifier_switch = m_hotkeys->GetSettingsModifier()[2];
-  return m_sideways_setting.GetValue() ^ sideways_modifier_toggle ^ sideways_modifier_switch;
+  bool sideways = m_sideways_setting.GetValue() ^ sideways_modifier_toggle ^ sideways_modifier_switch;
+  // RomCore: orientation forced by the input overrider (e.g. sideways grip <-> pointing grip)
+  if (m_input_override_function)
+    if (const auto o = m_input_override_function(ROMCORE_ORIENT_GROUP, "Sideways", sideways ? 1.0 : 0.0))
+      sideways = *o > 0.5;
+  return sideways;
 }
 
 bool Wiimote::IsUpright() const
 {
   const bool upright_modifier_toggle = m_hotkeys->GetSettingsModifier()[1];
   const bool upright_modifier_switch = m_hotkeys->GetSettingsModifier()[3];
-  return m_upright_setting.GetValue() ^ upright_modifier_toggle ^ upright_modifier_switch;
+  bool upright = m_upright_setting.GetValue() ^ upright_modifier_toggle ^ upright_modifier_switch;
+  if (m_input_override_function)
+    if (const auto o = m_input_override_function(ROMCORE_ORIENT_GROUP, "Upright", upright ? 1.0 : 0.0))
+      upright = *o > 0.5;
+  return upright;
 }
 
 void Wiimote::SetRumble(bool on)
diff --git a/Source/Core/InputCommon/ControllerEmu/ControlGroup/Cursor.cpp b/Source/Core/InputCommon/ControllerEmu/ControlGroup/Cursor.cpp
index 169846c..ea736f9 100644
--- a/Source/Core/InputCommon/ControllerEmu/ControlGroup/Cursor.cpp
+++ b/Source/Core/InputCommon/ControllerEmu/ControlGroup/Cursor.cpp
@@ -98,6 +98,16 @@ Cursor::StateData Cursor::GetState(const bool adjusted,
   if (const std::optional<ControlState> y_override = override_func(name, Y_INPUT_OVERRIDE, state.y))
     state.y = *y_override;
 
+  // RomCore: explicit "hide" override (pointer not aimed at the screen -> the game sees no IR dots at all).
+  if (const std::optional<ControlState> hide = override_func(name, HIDE_INPUT_OVERRIDE, 0.0))
+  {
+    if (*hide > 0.5)
+    {
+      state.x = std::numeric_limits<ControlState>::quiet_NaN();
+      state.y = 0;
+    }
+  }
+
   return state;
 }
 
diff --git a/Source/Core/InputCommon/ControllerEmu/ControlGroup/Cursor.h b/Source/Core/InputCommon/ControllerEmu/ControlGroup/Cursor.h
index 85a9cf1..e71a9f5 100644
--- a/Source/Core/InputCommon/ControllerEmu/ControlGroup/Cursor.h
+++ b/Source/Core/InputCommon/ControllerEmu/ControlGroup/Cursor.h
@@ -28,6 +28,8 @@ public:
   ControlState GetGateRadiusAtAngle(double ang) const override;
 
   // Modifies the state
+  static constexpr const char* HIDE_INPUT_OVERRIDE = "RomCoreHide";
+
   StateData GetState(bool adjusted);
   StateData GetState(bool adjusted, const ControllerEmu::InputOverrideFunction& override_func);
 
diff --git a/Source/Core/InputCommon/ControllerInterface/Touch/InputOverrider.cpp b/Source/Core/InputCommon/ControllerInterface/Touch/InputOverrider.cpp
index 9ddbaff..02d510d 100644
--- a/Source/Core/InputCommon/ControllerInterface/Touch/InputOverrider.cpp
+++ b/Source/Core/InputCommon/ControllerInterface/Touch/InputOverrider.cpp
@@ -21,6 +21,7 @@
 #include "Core/HW/WiimoteEmu/WiimoteEmu.h"
 
 #include "InputCommon/ControllerEmu/ControlGroup/Attachments.h"
+#include "InputCommon/ControllerEmu/ControlGroup/Cursor.h"
 #include "InputCommon/ControllerEmu/ControlGroup/ControlGroup.h"
 #include "InputCommon/ControllerEmu/ControllerEmu.h"
 #include "InputCommon/ControllerEmu/StickGate.h"
@@ -91,6 +92,10 @@ const ControlsMap s_wiimote_controls_map = {{
      ControlID::WIIMOTE_IR_X},
     {{WiimoteEmu::Wiimote::IR_GROUP, ControllerEmu::ReshapableInput::Y_INPUT_OVERRIDE},
      ControlID::WIIMOTE_IR_Y},
+    {{WiimoteEmu::Wiimote::IR_GROUP, ControllerEmu::Cursor::HIDE_INPUT_OVERRIDE},
+     ControlID::WIIMOTE_IR_HIDE},
+    {{"RomCoreOrient", "Sideways"}, ControlID::WIIMOTE_FORCE_SIDEWAYS},
+    {{"RomCoreOrient", "Upright"}, ControlID::WIIMOTE_FORCE_UPRIGHT},
 }};
 
 const ControlsMap s_nunchuk_controls_map = {{
diff --git a/Source/Core/InputCommon/ControllerInterface/Touch/InputOverrider.h b/Source/Core/InputCommon/ControllerInterface/Touch/InputOverrider.h
index 6217b44..f4acbca 100644
--- a/Source/Core/InputCommon/ControllerInterface/Touch/InputOverrider.h
+++ b/Source/Core/InputCommon/ControllerInterface/Touch/InputOverrider.h
@@ -68,12 +68,17 @@ enum ControlID
   CLASSIC_RIGHT_STICK_X = 54,
   CLASSIC_RIGHT_STICK_Y = 55,
 
+  // RomCore additions (appended so existing ids keep their values)
+  WIIMOTE_IR_HIDE = 56,        // >0.5: pointer hidden (game sees no IR dots)
+  WIIMOTE_FORCE_SIDEWAYS = 57, // overrides "Sideways Wiimote": 0 = flat/pointing grip, 1 = NES grip
+  WIIMOTE_FORCE_UPRIGHT = 58,  // overrides "Upright Wiimote": 1 = remote pointing at the ceiling
+
   NUMBER_OF_CONTROLS,
 
   FIRST_GC_CONTROL = GCPAD_A_BUTTON,
   LAST_GC_CONTROL = GCPAD_C_STICK_Y,
   FIRST_WII_CONTROL = WIIMOTE_A_BUTTON,
-  LAST_WII_CONTROL = CLASSIC_RIGHT_STICK_Y,
+  LAST_WII_CONTROL = WIIMOTE_FORCE_UPRIGHT,
 
 };
 void RegisterGameCubeInputOverrider(int controller_index);
-- 
