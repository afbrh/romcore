From b4dddccb4378b7ccc136e16d3d2af59b556d0921 Mon Sep 17 00:00:00 2001
From: Ry <noryanfound@gmail.com>
Date: Fri, 30 Oct 2026 21:42:22 -0500
Subject: [PATCH] RomCore embedding: SHIP_HOME on Android, embed API (events,
 pause, ready), no ImGui menu toggle when embedded, SDL2 Java package
 relocation (org.libsdl.apptwoship) + libSDL2twoship.so

---
 cmake/dependencies/android.cmake              |  3 +
 .../patches/romcore-sdl2-java-package.cmake   | 12 ++++
 include/ship/port/mobile/MobileImpl.h         |  9 +++
 src/ship/Context.cpp                          |  7 ++
 src/ship/port/mobile/MobileImpl.cpp           | 71 +++++++++++++++++++
 src/ship/window/gui/Gui.cpp                   | 11 ++-
 6 files changed, 110 insertions(+), 3 deletions(-)
 create mode 100644 cmake/dependencies/patches/romcore-sdl2-java-package.cmake

diff --git a/cmake/dependencies/android.cmake b/cmake/dependencies/android.cmake
index 97f5971f..9340b1f7 100644
--- a/cmake/dependencies/android.cmake
+++ b/cmake/dependencies/android.cmake
@@ -9,8 +9,11 @@ if (NOT ${SDL2_FOUND})
         GIT_TAG release-2.32.10
         GIT_SHALLOW TRUE
         OVERRIDE_FIND_PACKAGE
+        PATCH_COMMAND ${CMAKE_COMMAND} -DSDL_SRC=<SOURCE_DIR> -P ${CMAKE_CURRENT_LIST_DIR}/patches/romcore-sdl2-java-package.cmake
     )
     FetchContent_MakeAvailable(SDL2)
+    # RomCore: the shared library is libSDL2twoship.so (Ship of Harkinian's libSDL2.so lives in the same APK).
+    set_target_properties(SDL2 PROPERTIES OUTPUT_NAME SDL2twoship)
 endif()
 
 #=================== nlohmann-json ===================
diff --git a/cmake/dependencies/patches/romcore-sdl2-java-package.cmake b/cmake/dependencies/patches/romcore-sdl2-java-package.cmake
new file mode 100644
index 00000000..2401299b
--- /dev/null
+++ b/cmake/dependencies/patches/romcore-sdl2-java-package.cmake
@@ -0,0 +1,12 @@
+# RomCore: relocate SDL2's Android Java package org.libsdl.app -> org.libsdl.apptwoship so it cannot clash with the (different) SDL2
+# Java classes other RomCore cores already ship (org.libsdl.app: Eden/Azahar, org.libsdl.appsoh: Ship of Harkinian).
+# Run as: cmake -DSDL_SRC=<sdl2 source dir> -P romcore-sdl2-java-package.cmake
+# (idempotent: already-renamed sources are left alone).
+foreach(f src/core/android/SDL_android.c src/video/android/SDL_androidevents.c src/hidapi/android/hid.cpp)
+    set(path "${SDL_SRC}/${f}")
+    file(READ "${path}" content)
+    string(REPLACE "org_libsdl_app_" "org_libsdl_apptwoship_" content "${content}")
+    string(REGEX REPLACE "org_libsdl_app([^s_a-zA-Z0-9t])" "org_libsdl_apptwoship\\1" content "${content}")
+    string(REPLACE "org/libsdl/app/" "org/libsdl/apptwoship/" content "${content}")
+    file(WRITE "${path}" "${content}")
+endforeach()
diff --git a/include/ship/port/mobile/MobileImpl.h b/include/ship/port/mobile/MobileImpl.h
index fa57dd8a..010a8202 100644
--- a/include/ship/port/mobile/MobileImpl.h
+++ b/include/ship/port/mobile/MobileImpl.h
@@ -23,6 +23,15 @@ class Mobile {
     static void SetCrashContext(const char* context);
     static void InitThreadDiagnostics();
     static void LogMemorySample(size_t combinerCount);
+
+    // ---- RomCore embedding (env ROMCORE_EMBED=1): the host app owns every pixel that is not the game ----
+    // True when 2Ship runs inside RomCore: no ImGui menu, no extraction popups, no touch overlay, no Java dialogs.
+    static bool RomCoreEmbedded();
+    // Native -> host event (MainActivity.onRomCoreEvent): 0 = first frames on screen, 1 = notice(a), 2 = fatal(a=title,b=message),
+    // 3 = progress(a = loading text, b = 0..1).
+    static void RomCoreEvent(int kind, const std::string& a, const std::string& b);
+    // Called once per game frame from the game thread: fires the "ready" event and blocks while the host has the game paused.
+    static void RomCoreOnGameFrame();
 #endif
 };
 }; // namespace Ship
