+        CheckAndCreateModFolder();
+        RomCoreExtract(std::filesystem::absolute(Ship::Context::GetAppBundlePath()).string(),
+                       std::filesystem::absolute(Ship::Context::GetAppDirectoryPath(appShortName)).string());
+        return;
+    }
