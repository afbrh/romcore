-import org.libsdl.app.SDLActivity;
+import org.libsdl.apptwoship.SDLActivity;
 
 import android.app.AlertDialog;
 import android.content.Context;
@@ -72,6 +72,9 @@ public class MainActivity extends SDLActivity{
     private static final String SUPPORT_FILES_VERSION_MARKER = ".android_support_files_version";
     private static final String SAFE_MODE_MARKER = ".android_safe_mode";
     private static final String SUPPORT_ARCHIVE = "2ship.o2r";
+    // Library builds have no BuildConfig.VERSION_* / APPLICATION_ID; keep in step with androidAppVersionCode/Name in app/build.gradle.
+    static final int APP_VERSION_CODE = 5001035;
+    static final String APP_VERSION_NAME = "5.0.1-android.3";
     private static final String DEFAULT_SHADER = "shaders/opengl/default.shader.glsl";
     private AlertDialog dataRootMigrationDialog;
     private AlertDialog setupProgressDialog;
@@ -86,6 +89,17 @@ public class MainActivity extends SDLActivity{
         updateCurrentDataRootPath();
         recoverWithoutMods = AndroidCrashReporter.install(this, getTargetRootFolder());
 
+        if (isRomCoreEmbedded()) {
+            // RomCore embedding: the host prepares the data directory (2ship.o2r, assets/, config) before this Activity
+            // starts, owns every pixel that is not the game, and feeds the one virtual pad. No permission flow, no setup
+            // dialog, no touch overlay, no storage migration.
+            setupLatch.countDown();
+            super.onCreate(savedInstanceState);
+            attachController();
+            Log.i("2Ship", "onCreate complete (RomCore embedded)");
+            return;
+        }
+
         if (hasStoragePermission()) {
             beginSetupOrChooseDataRoot();
         } else {
@@ -107,11 +121,23 @@ public class MainActivity extends SDLActivity{
         attachController();
     }
 
+    /** RomCore subclasses return true: no overlay, no setup/permission flow, no Java dialogs. */
+    protected boolean isRomCoreEmbedded() {
+        return false;
+    }
+
+    /** Native -> host events (RomCore): 0 ready, 1 notice(a), 2 fatal(a=title, b=message), 3 progress(a=text, b=0..1). Default: ignore. */
+    public void onRomCoreEvent(int kind, String a, String b) {
+    }
+
+    public native void nativeRomCoreSetPaused(boolean paused);
+    public native void nativeRomCoreReleaseAll();
+
     @Override
     public void loadLibraries() {
         super.loadLibraries();
         nativeInstallCrashReporter(AndroidCrashReporter.getNativeReportFile().getAbsolutePath(),
-                BuildConfig.VERSION_NAME);
+                APP_VERSION_NAME);
     }
 
     private native void nativeInstallCrashReporter(String reportPath, String versionName);
@@ -132,6 +158,9 @@ public class MainActivity extends SDLActivity{
     }
 
     private void applyImmersiveFullscreen() {
+        if (isRomCoreEmbedded()) {
+            return; // RomCore's Activity owns the window flags
+        }
         Window window = getWindow();
         if (window == null) {
             return;
@@ -187,7 +216,7 @@ public class MainActivity extends SDLActivity{
     }
 
     private void doVersionCheck(){
-        int currentVersion = BuildConfig.VERSION_CODE;
+        int currentVersion = APP_VERSION_CODE;
         supportFilesNeedRefresh = !isSupportFilesMarkerCurrent() || !isSupportArchiveCurrent();
         preferences.edit().putInt("appVersion", currentVersion).apply();
     }
@@ -242,7 +271,7 @@ public class MainActivity extends SDLActivity{
                 return false;
             }
             String markerVersion = new String(buffer, 0, read).trim();
-            return markerVersion.equals(String.valueOf(BuildConfig.VERSION_CODE));
+            return markerVersion.equals(String.valueOf(APP_VERSION_CODE));
         } catch (IOException e) {
             Log.w("setupFiles", "Unable to read support files marker", e);
             return false;
@@ -252,7 +281,7 @@ public class MainActivity extends SDLActivity{
     private void writeSupportFilesMarker(File targetRootFolder) throws IOException {
         File markerFile = getSupportFilesMarkerFile(targetRootFolder);
         try (OutputStream out = new FileOutputStream(markerFile)) {
-            out.write(String.valueOf(BuildConfig.VERSION_CODE).getBytes());
+            out.write(String.valueOf(APP_VERSION_CODE).getBytes());
         }
     }
 
@@ -290,6 +319,12 @@ public class MainActivity extends SDLActivity{
     }
 
     private File getTargetRootFolder() {
+        if (isRomCoreEmbedded()) {
+            String shipHome = System.getenv("SHIP_HOME");
+            if (shipHome != null && !shipHome.isEmpty()) {
+                return new File(shipHome);
+            }
+        }
         String configuredPath = preferences.getString(PREF_DATA_ROOT_PATH, null);
         if (configuredPath == null || configuredPath.isEmpty()) {
             return getDefaultDataRootFolder();
@@ -299,10 +334,6 @@ public class MainActivity extends SDLActivity{
     }
 
     private File getDefaultDataRootFolder() {
-        if (BuildConfig.APPLICATION_ID.equals("com.twoshipfork.mm.performancetest") ||
-                BuildConfig.APPLICATION_ID.equals("com.twoshipfork.mm.performancetestci")) {
-            return new File(Environment.getExternalStorageDirectory(), "2S2H-performance-test");
-        }
         return new File(Environment.getExternalStorageDirectory(), "2S2H");
     }
 
@@ -921,6 +952,9 @@ public class MainActivity extends SDLActivity{
 
 
     public void openFilePicker() {
+        if (isRomCoreEmbedded()) {
+            return;
+        }
         // Create an Intent to open the file picker dialog
         Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
         intent.setType("*/*");
