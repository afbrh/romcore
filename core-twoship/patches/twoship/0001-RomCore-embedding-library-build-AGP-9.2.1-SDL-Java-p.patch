--- a/Android/app/build.gradle
+++ b/Android/app/build.gradle
@@ -12,19 +12,24 @@ else {
     apply plugin: 'com.android.library'
 }
 
+// RomCore: consumed as a library by the composite build (module com.twoshipfork:app).
+group = 'com.twoshipfork'
+version = 'embedded'
+
