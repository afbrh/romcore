     buildFeatures {
         buildConfig true
     }
-    ndkVersion "26.0.10792818"
-    compileSdkVersion 33
+    ndkVersion "27.3.13750724"
+    compileSdk 37
+    namespace 'com.twoshipfork.mm'
     defaultConfig {
         if (buildAsApplication) {
             applicationId project.findProperty('twoShipApplicationId') ?: "com.twoshipfork.mm"
-            namespace("com.twoshipfork.mm")
         }
-        minSdkVersion 24
-        targetSdkVersion 33
+        minSdk 30
+        consumerProguardFiles 'consumer-rules.pro'
+        targetSdk 33
         versionCode androidAppVersionCode
         versionName androidAppVersionName
         manifestPlaceholders = [twoShipAppLabel: project.findProperty('twoShipAppLabel') ?: "@string/app_name"]
@@ -37,7 +42,7 @@ android {
                  if (project.hasProperty('twoShipPerformanceTest')) {
                      arguments "-DTWO_SHIP_PERFORMANCE_TEST=ON"
                  }
-                 arguments "-DSDL_SHARED=ON", "-DANDROID_STL=c++_static", "-DHAVE_LD_VERSION_SCRIPT=OFF",'-DUSE_OPENGLES=ON', "-DPNG_SHARED=OFF", "-DPNG_STATIC=ON", "-DPNG_TESTS=OFF", "-DANDROID_VCPKG_ROOT=${androidVcpkgRootArg}", "-DANDROID_APP_VERSION_NAME=${androidAppVersionName}"
+                 arguments "-DCMAKE_BUILD_TYPE=Release", "-DSDL_SHARED=ON", "-DANDROID_STL=c++_static", "-DHAVE_LD_VERSION_SCRIPT=OFF",'-DUSE_OPENGLES=ON', "-DPNG_SHARED=OFF", "-DPNG_STATIC=ON", "-DPNG_TESTS=OFF", "-DANDROID_VCPKG_ROOT=${androidVcpkgRootArg}", "-DANDROID_APP_VERSION_NAME=${androidAppVersionName}"
                  abiFilters 'arm64-v8a'
             }
         }
@@ -63,12 +68,14 @@ android {
         release {
             signingConfig hasReleaseSigning ? signingConfigs.release : signingConfigs.debug
             minifyEnabled false
-            proguardFiles getDefaultProguardFile('proguard-android.txt'), 'proguard-rules.pro'
+            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
         }
     }
-    applicationVariants.all { variant ->
-        tasks["merge${variant.name.capitalize()}Assets"]
-            .dependsOn("externalNativeBuild${variant.name.capitalize()}", "verifyBundledAssets")
+    if (buildAsApplication) {
+        applicationVariants.all { variant ->
+            tasks["merge${variant.name.capitalize()}Assets"]
+                .dependsOn("externalNativeBuild${variant.name.capitalize()}", "verifyBundledAssets")
+        }
     }
     if (!project.hasProperty('EXCLUDE_NATIVE_LIBS')) {
         sourceSets.main {
@@ -80,26 +87,14 @@ android {
             //}
             cmake {
                  path '../../CMakeLists.txt'
-                 version "3.30.3"
+                 version "3.31.6"
             }
         }
 
     }
-    lintOptions {
+    lint {
         abortOnError false
     }
-
-    if (buildAsLibrary) {
-        libraryVariants.all { variant ->
-            variant.outputs.each { output ->
-                def outputFile = output.outputFile
-                if (outputFile != null && outputFile.name.endsWith(".aar")) {
-                    def fileName = "org.libsdl.app.aar";
-                    output.outputFile = new File(outputFile.parent, fileName);
-                }
-            }
-        }
-    }
 }
 
 dependencies {
@@ -108,6 +103,15 @@ dependencies {
     implementation 'androidx.constraintlayout:constraintlayout:2.1.4'
 }
 
+// RomCore: CMake's configure step copies the extractor assets into src/main/assets/twoship/assets (see ../CMakeLists.txt). In the stock
+// application build the asset merge already waits for the native build; do the same for the library variants, so a fresh checkout
+// packages them on the first build.
+afterEvaluate {
+    tasks.matching { it.name ==~ /merge\w+Assets/ }.configureEach { assetTask ->
+        assetTask.dependsOn({ tasks.matching { it.name.startsWith('configureCMake') }.toList() })
+    }
+}
+
 tasks.register("verifyBundledAssets") {
     def bundled2ShipOtr = file("src/main/assets/2ship.o2r")
     def bundledRomOtr = file("src/main/assets/mm.o2r")
@@ -123,9 +127,3 @@ tasks.register("verifyBundledAssets") {
     }
 }
 
-task wrapper(type: Wrapper) {
-    gradleVersion = '8.3.2'
-}
-
-task prepareKotlinBuildScriptModel {
-}
diff --git a/Android/app/consumer-rules.pro b/Android/app/consumer-rules.pro
new file mode 100644
index 000000000..e4133804b
--- /dev/null
+++ b/Android/app/consumer-rules.pro
@@ -0,0 +1,4 @@
+# RomCore: the embedding app minifies even debug builds. Everything below is called from native code (JNI) by name, or registers its
+# natives by name (SDL's JNI_OnLoad register_methods), so it must keep its exact names.
+-keep class org.libsdl.apptwoship.** { *; }
+-keep class com.twoshipfork.mm.** { *; }
