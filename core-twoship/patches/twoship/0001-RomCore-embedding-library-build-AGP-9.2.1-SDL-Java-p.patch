+// RomCore embedding: the host shows the loading screen / error panel; 2Ship shows nothing while it prepares its game files.
+[[noreturn]] static void RomCoreFatal(const std::string& title, const std::string& message) {
+    Ship::Mobile::RomCoreEvent(2, title, message);
+    // The host closes the game (ends this process) once the user dismisses its error panel.
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+    }
+}
+
+static void RomCoreExtract(const std::string& installPath, const std::string& dataPath) {
+    namespace fs = std::filesystem;
+    auto o2rExists = [&]() { return fs::exists(Ship::Context::LocateFileAcrossAppDirs("mm.o2r", appShortName)); };
+    if (!shipArchiveVersionMatch) {
+        RomCoreFatal("Majora's Mask", "The 2 Ship 2 Harkinian core is missing its 2ship.o2r asset archive (or it is outdated).");
+    }
+    if (!fs::exists(installPath + "/assets")) {
+        RomCoreFatal("Majora's Mask", "The 2 Ship 2 Harkinian core is missing its extractor assets.");
+    }
+    // A mm.o2r made by an incompatible 2Ship version is dropped and rebuilt from the ROM.
+    if (o2rExists() && VerifyArchiveVersion(DetectArchiveVersion("mm.o2r", true))) {
+        RemoveArchiveAcrossAppDirs("mm.o2r");
+    }
+    if (o2rExists()) {
+        return;
+    }
+    const char* rom = std::getenv("ROMCORE_2SHIP_ROM");
+    if (rom == nullptr || rom[0] == '\0') {
+        RomCoreFatal("Majora's Mask", "No ROM was passed to the 2 Ship 2 Harkinian core.");
+    }
+    Extractor extract;
+    if (!extract.RunFileStandalone(rom)) {
+        RomCoreFatal("Majora's Mask",
+                     "This file is not a supported Majora's Mask ROM. Use a .z64 / .n64 / .v64 dump of the NTSC-U 1.0 "
+                     "(or NTSC-U GameCube) release.");
+    }
+    std::atomic<size_t> count{ 0 };
+    std::atomic<size_t> total{ 0 };
+    std::atomic<bool> done{ false };
+    std::thread worker([&]() {
+        extract.CallZapd(installPath, dataPath, &count, &total);
+        done = true;
+    });
+    int lastPercent = -1;
+    while (!done) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(250));
+        const size_t t = total.load();
+        const int percent = t > 0 ? (int)(count.load() * 100 / t) : 0;
+        if (percent != lastPercent) {
+            lastPercent = percent;
+            Ship::Mobile::RomCoreEvent(3, "Preparing Majora's Mask (first launch only) " + std::to_string(percent) + "%",
+                                       std::to_string(percent / 100.0f));
+        }
+    }
+    worker.join();
+    if (!o2rExists()) {
+        RomCoreFatal("Majora's Mask", "The game files could not be created from this ROM.");
+    }
+}
+#endif
+
