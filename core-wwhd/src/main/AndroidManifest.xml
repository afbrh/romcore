<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The runtime needs Vulkan 1.1 (GX2 is implemented directly on it). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />

    <!-- The first-time "prepare game" step (extract the .wua, translate the game's code on the device) takes minutes: it runs as a
         foreground service so the system does not end the process while RomCore is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>

        <!-- The whole runtime lives in its own process: libwwhd.so reserves a 4 GiB guest window, links LLVM/glslang statically and
             exits the process when the game ends, so it must never share an address space with another RomCore core. -->
        <activity
            android:name="com.noryan.romcore.core.wwhd.WwhdActivity"
            android:process=":wwhd"
            android:taskAffinity="com.noryan.romcore.wwhd"
            android:launchMode="singleTask"
            android:exported="false"
            android:alwaysRetainTaskState="true"
            android:screenOrientation="landscape"
            android:preferMinimalPostProcessing="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density" />

        <service
            android:name="com.noryan.romcore.core.wwhd.WwhdKeepAliveService"
            android:process=":wwhd"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
